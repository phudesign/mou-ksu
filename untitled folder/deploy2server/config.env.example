# คัดลอกเป็น config.env แล้วแก้ค่าให้ตรงเซิร์ฟเวอร์จริง
#   cp config.env.example config.env
#
# อย่า commit ไฟล์ config.env ถ้ามีค่าลับ/โดเมนภายใน

# Namespace ที่ admin สร้างให้แล้ว (สคริปต์จะไม่สร้าง namespace ใหม่)
NAMESPACE=mou

# Container Registry ขององค์กร (ไม่มี / ท้าย)
# ตัวอย่าง: registry.example.com/mou หรือ ghcr.io/org/mou
REGISTRY=registry.example.com/mou

# แท็กเวอร์ชัน image (แนะนำใช้ semver หรือวันที่)
IMAGE_TAG=1.0.0

# โดเมนที่ผู้ใช้เปิดในเบราว์เซอร์ (ต้องตรงกับ OpenShift Route / DNS)
INGRESS_HOST=mou.example.com

# CORS — ปกติเป็น https:// + โดเมนด้านบน (เว็บกับ API same-origin ผ่าน Nginx)
CORS_ORIGIN=https://mou.example.com

# เปิด TLS ที่ Route หรือไม่ (edge — ใบรับรองมักอยู่ที่ OpenShift Router)
# true / false
ENABLE_TLS=false

# StorageClass สำหรับ PVC (ว่าง = ใช้ default ของคลัสเตอร์)
STORAGE_CLASS=

# ถ้า registry ต้อง login ด้วย imagePullSecret ที่ admin สร้างใน namespace แล้ว
# ว่าง = ไม่ใส่ imagePullSecrets
IMAGE_PULL_SECRET=

# ขนาดดิสก์
MYSQL_STORAGE=10Gi
UPLOADS_STORAGE=5Gi

# เส้นทาง build context (relative จากโฟลเดอร์ deploy2server)
# ค่าเริ่มต้นใช้แพ็กเกจในตัว — ไม่ต้องพึ่งโฟลเดอร์นอก deploy2server
BACKEND_CONTEXT=./build/backend
WEB_CONTEXT=./build/frontend
